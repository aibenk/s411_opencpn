    <gml:Envelope srsName="http://www.opengis.net/def/crs/EPSG/0/4326" srsDimension="2">
      <gml:lowerCorner>53.5 9.3</gml:lowerCorner>
      <gml:upperCorner>54.9 14.3</gml:upperCorner>
    </gml:Envelope>
  </gml:boundedBy>
